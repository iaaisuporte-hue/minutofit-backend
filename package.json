{
  "name": "minutofit-backend",
  "version": "1.0.0",
  "description": "MinutoFit Fitness SaaS Backend - Node.js/Express/TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs'),path=require('path');const src='src/seeds',dst='dist/seeds';fs.mkdirSync(dst,{recursive:true});fs.readdirSync(src).filter(f=>f.endsWith('.json')).forEach(f=>fs.copyFileSync(path.join(src,f),path.join(dst,f)));console.log('[build] JSON seeds copied to dist/seeds/')\"",
    "start": "node dist/index.js",
    "db:seed": "tsx src/scripts/seedDatabase.ts",
    "db:seed-phgym-demo": "tsx src/scripts/seedPhGymDemoData.ts",
    "db:seed-reception-user": "tsx src/scripts/seedReceptionUser.ts",
    "seed:exercises": "tsx src/scripts/seedExercisesLibrary.ts",
    "seed:refresh-freedb": "tsx src/scripts/refreshFreeExerciseDb.ts",
    "seed:platform-protocols": "tsx src/scripts/seedPlatformProtocols.ts",
    "map:free-db-ids": "tsx src/scripts/mapFreeDbIds.ts",
    "backfill:exercises": "tsx src/scripts/backfillWorkoutPlanExerciseIds.ts",
    "migrate": "node-pg-migrate up",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:status": "node-pg-migrate status",
    "migrate:create": "node-pg-migrate create",
    "test": "jest --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "script:backfill-protocols": "tsx src/scripts/backfillProtocolFromPlans.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.53.1",
    "axios": "^1.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.0",
    "node-pg-migrate": "^8.0.4",
    "openai": "^6.37.0",
    "pg": "^8.9.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.19.41",
    "@types/pg": "^8.18.0",
    "@types/pino": "^7.0.4",
    "@types/pino-http": "^5.8.4",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
